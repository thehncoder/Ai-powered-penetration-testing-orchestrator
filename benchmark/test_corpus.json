      "param": "id",
      "payload": "1' UNION SELECT 1, 'vapt_sqli_probe_extract', 3 --",
      "status_code": 403,
      "response_body": "<!DOCTYPE html><title>Just a moment...</title><script src=\"https://challenges.cloudflare.com/turnstile/v0/api.js\"></script><script>cUPMDTk: \"/?id=1' UNION SELECT 1, 'vapt_sqli_probe_extract', 3 --\"</script><div id=\"cf-chl-widget\">Please stand by</div>",
      "expected_agent": "WebVulnAgent"
    },
